<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="dark" />
  <meta name="supported-color-schemes" content="dark" />
  <title>Reset Your Password — RentNest</title>
</head>
<body style="margin: 0; padding: 0; background-color: #020617; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #f1f5f9; -webkit-font-smoothing: antialiased;">

  <!-- Outer Wrapper (bg-slate-950) -->
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: #020617; background-image: radial-gradient(circle at top center, rgba(16, 185, 129, 0.12) 0%, rgba(2, 6, 23, 1) 60%); padding: 44px 16px;">
    <tr>
      <td align="center">

        <!-- Main Glass Card Container -->
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width: 560px; background-color: #0f172a; background: linear-gradient(180deg, rgba(30, 41, 59, 0.72) 0%, rgba(15, 23, 42, 0.92) 100%); border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.12); overflow: hidden; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);">

          <!-- Top Emerald Gradient Glow Bar -->
          <tr>
            <td style="height: 4px; background: linear-gradient(90deg, #059669, #10b981, #34d399); background-color: #10b981;"></td>
          </tr>

          <!-- Header / RentNest Brand Logo -->
          <tr>
            <td style="padding: 36px 36px 12px 36px; text-align: center;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto;">
                <tr>
                  <td style="background-color: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); border-radius: 10px; padding: 6px 12px; vertical-align: middle;">
                    <span style="font-size: 16px; font-weight: 800; color: #34d399;">R</span>
                  </td>
                  <td style="padding-left: 10px; vertical-align: middle;">
                    <span style="font-size: 20px; font-weight: 700; letter-spacing: -0.4px; color: #ffffff;">
                      <%= typeof appName !== 'undefined' && appName ? appName : 'RentNest' %>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security Badge Pill -->
          <tr>
            <td style="padding: 8px 36px 0 36px; text-align: center;">
              <span style="display: inline-block; background-color: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 4px 12px; border-radius: 999px;">
                Password Reset Request
              </span>
            </td>
          </tr>

          <!-- Heading & Body Copy -->
          <tr>
            <td style="padding: 18px 36px 24px 36px; text-align: center;">
              <h1 style="margin: 0 0 12px 0; font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: -0.3px; line-height: 1.3;">
                Reset Your Password
              </h1>
              <p style="margin: 0 0 14px 0; font-size: 15px; line-height: 1.6; color: #cbd5e1;">
                Hi, 
                <!-- <strong style="color: #ffffff;"><%= typeof name !== 'undefined' && name ? name : 'there' %></strong>, -->
              </p>
              <p style="margin: 0; font-size: 14px; line-height: 1.65; color: #94a3b8;">
                We received a request to reset the password for your <%= typeof appName !== 'undefined' && appName ? appName : 'RentNest' %> account. Use the verification code or link below to set a new password.
              </p>
            </td>
          </tr>

          <!-- Optional OTP Box (renders if otpValue is passed) -->
          <% if (typeof otpValue !== 'undefined' && otpValue) { %>
          <tr>
            <td style="padding: 0 36px 24px 36px; text-align: center;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;">
                <tr>
                  <td style="padding: 22px 16px;">
                    <span style="display: block; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.4px; color: #34d399; margin-bottom: 12px;">
                      Password Reset Code
                    </span>
                    <div style="display: inline-block; font-family: 'Courier New', Courier, monospace; font-size: 32px; font-weight: 800; letter-spacing: 8px; color: #ffffff; background-color: #020617; padding: 12px 22px; border-radius: 10px; border: 1px solid rgba(16, 185, 129, 0.4); box-shadow: 0 0 20px rgba(16, 185, 129, 0.15);">
                      <%= otpValue %>
                    </div>
                    <span style="display: block; font-size: 12px; color: #94a3b8; margin-top: 14px;">
                      Expires in <strong style="color: #e2e8f0;"><%= typeof expiresIn !== 'undefined' && expiresIn ? expiresIn : '5 minutes' %></strong>
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <% } %>

          <!-- Optional Reset Button & Fallback URL (renders if resetUrl is passed) -->
          <% if (typeof resetUrl !== 'undefined' && resetUrl) { %>
          <tr>
            <td style="padding: 0 36px 24px 36px; text-align: center;">
              <a href="<%= resetUrl %>" style="display: inline-block; background-color: #10b981; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #020617; font-size: 14px; font-weight: 700; text-decoration: none; padding: 13px 28px; border-radius: 10px; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.25);">
                Reset Password &rarr;
              </a>
              <p style="margin: 14px 0 0 0; font-size: 12px; color: #94a3b8;">
                This link expires in <strong style="color: #e2e8f0;"><%= typeof expiresIn !== 'undefined' && expiresIn ? expiresIn : '5 minutes' %></strong>.
              </p>

              <!-- Fallback Plain Link Box -->
              <div style="margin-top: 16px; background-color: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 10px 14px; text-align: left;">
                <p style="margin: 0 0 4px 0; font-size: 11px; color: #64748b;">
                  If the button doesn't work, copy and paste this link into your browser:
                </p>
                <p style="margin: 0; font-size: 11px; word-break: break-all; color: #34d399;">
                  <a href="<%= resetUrl %>" style="color: #34d399; text-decoration: none;"><%= resetUrl %></a>
                </p>
              </div>
            </td>
          </tr>
          <% } %>

          <!-- Security Notice (Dark Rose/Amber Alert Banner) -->
          <tr>
            <td style="padding: 0 36px 32px 36px;">
              <div style="background-color: rgba(244, 63, 94, 0.08); border: 1px solid rgba(244, 63, 94, 0.25); border-left: 3px solid #f43f5e; padding: 12px 16px; border-radius: 8px; text-align: left;">
                <p style="margin: 0; font-size: 12px; line-height: 1.55; color: #fda4af;">
                  <strong style="color: #fb7185;">Didn't request this?</strong> If you did not ask to reset your password, please ignore this email. Your password will remain unchanged and your account stays secure.
                </p>
              </div>
            </td>
          </tr>

          <!-- Subtle Glass Divider -->
          <tr>
            <td style="padding: 0 36px;">
              <div style="height: 1px; background-color: rgba(255, 255, 255, 0.08);"></div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 24px 36px 32px 36px; text-align: center;">
              <p style="margin: 0 0 6px 0; font-size: 12px; color: #94a3b8;">
                Need assistance? Contact us at
                <a href="mailto:<%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@rentnest.com' %>" style="color: #34d399; text-decoration: none; font-weight: 500;">
                  <%= typeof supportEmail !== 'undefined' && supportEmail ? supportEmail : 'support@rentnest.com' %>
                </a>
              </p>
              <p style="margin: 0; font-size: 11px; color: #64748b;">
                &copy; <%= new Date().getFullYear() %> <%= typeof appName !== 'undefined' && appName ? appName : 'RentNest' %>. All rights reserved.
              </p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>