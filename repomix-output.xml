    const { categoryType } = req.body;

    const createdCategory = await categoriesService.addCategory(categoryType);

    sendResponse(res, {
        success: true,
        statusCode: httpStatus.CREATED,
        message: "Category Type Added Successfully",
        data: createdCategory,
    });
});

// ================================================================
