<file path="src/utils/catchAsync.ts">
import { NextFunction, Request, RequestHandler, Response } from "express";

// A function that return an async function for successfull execution
export const catchAsync = (fn: RequestHandler) => {
    return async (req: Request, res: Response, next: NextFunction) => {
        try {
            await fn(req, res, next);
        } catch (error) {
            next(error);
        }
    };
};
</file>

<file path="src/utils/isLoggedIn.ts">
import { Request } from "express";
import { AppError } from "../middlewares/appError";
import httpStatus from "http-status";

export const isLoggedIn = (req: Request) => {
    if (!req.user) {
        throw new AppError(httpStatus.UNAUTHORIZED, "Authorization Required!");
    }
};
</file>

<file path="src/utils/sendResponse.ts">
import { Response } from "express";

// Data type declaration for sendResponse
type TResponseData<T> = {
    success: boolean;
    statusCode: number;
    message: string;
    data: T;
};

export const sendResponse = <T>(res: Response, data: TResponseData<T>) => {
    res.status(data.statusCode).json({
        success: data.success,
        statusCode: data.statusCode,
        message: data.message,
        data: data.data,
    });
};
</file>

