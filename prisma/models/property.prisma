model Property {
  id          String   @id @default(uuid())
  title       String
  description String
  location    String
  price       Int
  amenities   String[]
  thumbnail   String?
  images      String[]
  isAvailable AvailabilityStatus @default(Available)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Relations
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  landLordId String
  landLord   Landlord   @relation(fields: [landLordId], references: [id], onDelete: Cascade)
  bookings Bookings[]
  reviews Review[]

  @@index([location, price])
  @@map("properties")
}
