model Payment {
  id            String                @id @default(uuid())
  transactionId String                @unique
  amount        Decimal               @db.Decimal(10, 2)
  method        String?
  provider      PaymentMethodProvider
  status        PaymentStatus         @default(PENDING)
  paidAt        DateTime?
  // Relations
  bookingId     String
  bookings      Bookings              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Tenant                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  landlordId    String
  landLord      Landlord              @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@map("payments")
}
