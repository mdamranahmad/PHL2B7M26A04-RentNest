model User {
  id            String     @id @default(uuid())
  name          String     @db.VarChar(255)
  email         String     @unique @db.VarChar(100)
  passwordHash  String
  age           Int?
  contactNo     String?    @db.VarChar(20)
  profilePhoto  String?
  emailVerified Boolean    @default(false)
  role          Role
  status        UserStatus @default(ACTIVE)
  isDeleted     Boolean    @default(false)
  // Relations
  landLord      Landlord?
  tenant        Tenant?
  // tenantRequests   RentalRequest[] @relation("RentalRequestByTenant")
  // landLordRequests RentalRequest[] @relation("RentalRequestToLandLord")
  // reviews          Review[]
  // properties       Property[]
  // // subscription     Subscription?
  // payment          Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactNo])
  @@map("users")
}
