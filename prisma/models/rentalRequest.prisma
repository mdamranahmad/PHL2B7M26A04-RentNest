model RentalRequest {
    id String @id @default(uuid())
    rentRequestStatus RentRequestStatus

    // Relations 
    propertyId String
    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    tenant User @relation(name: "RentalRequestByTenant", fields: [tenantId], references: [id])
    tenantId String

    landLord User @relation(name: "RentalRequestToLandLord",fields: [landLordId], references: [id])
    landLordId String

    payments Payment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    @@map("rentalRequests")
}